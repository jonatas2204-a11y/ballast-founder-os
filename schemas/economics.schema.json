    "application_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "approval_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "funding_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "average_financed_ticket": {"type": "number", "minimum": 0},
    "ballast_take_rate": {"type": "number", "minimum": 0},
    "monthly_fee_per_merchant": {"type": "number", "minimum": 0},
    "variable_cost_rate": {"type": "number", "minimum": 0},
    "variable_cost_per_application": {"type": "number", "minimum": 0},
